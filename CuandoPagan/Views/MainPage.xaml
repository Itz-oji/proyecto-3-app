<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:CuandoPagan.ViewModels"
    x:Class="CuandoPagan.Views.MainPage">


    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label
            Text="Hola, indícanos tu nombre"
            FontSize="26"
            HorizontalOptions="Center" />

        <Entry
            Placeholder="Escribe tu nombre"
            Text="{Binding Nombre}" />

        <Button
            Text="Guardar"
            Command="{Binding GuardarNombreCommand}" />

        <Button
            Text="Cargar nombres guardados"
            Command="{Binding CargarUsuariosCommand}" />

        <Picker
            Title="Selecciona un nombre guardado"
            ItemsSource="{Binding Usuarios}"
            ItemDisplayBinding="{Binding Nombre}"
            SelectedItem="{Binding UsuarioSeleccionado}" />

        <Label
            Text="{Binding Mensaje}"
            FontSize="16"
            HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>