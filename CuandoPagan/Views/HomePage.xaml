<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CuandoPagan.Views.HomePage"
    Title="Principal">

    <VerticalStackLayout Padding="30" Spacing="20">

        <Label
            Text="{Binding Nombre}"
            FontSize="36"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="Bienvenido a CuandoPagan"
            FontSize="20"
            HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>